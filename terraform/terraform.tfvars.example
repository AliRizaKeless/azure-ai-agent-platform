# Example values for local Terraform deployments
# Copy this file to terraform.tfvars and customize the values as needed
# Do not store secrets or credentials in this file
# Example values for local Terraform deployments 
location = "norwayeast" 
resource_group_name = "rg-ai-agent-platform" 
container_registry_name = "acraliagentplatform" 
environment = "dev" 
container_registry_sku = "Basic" 
container_registry_admin_enabled = true 
project_name = "azure-ai-agent-platform"
